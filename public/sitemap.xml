<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every real route the app serves. Kept by hand because there are six of them
  and they change about as often as the business does; a generator would be more
  machinery than the problem deserves.

  If you add a route to ROUTES in src/App.tsx, add it here and to
  public/_redirects in the same commit — a route missing from _redirects now
  returns a 404 status rather than silently rendering, which is the point of
  that file, and one missing from here simply never gets crawled.
-->
