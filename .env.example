# Airtable Personal Access Token (read-only, scoped to the Naughty Berry base)
# Generate one at https://airtable.com/create/tokens
# Required scopes: data.records:read
# Access: appIfLyWzGV0npV6U (Naughty Berry base)
VITE_AIRTABLE_TOKEN=your_airtable_personal_access_token_here

# Airtable write token, used ONLY by netlify/functions/enquiry.mts to create
# rows in the Enquiries table. Required scopes: data.records:write
#
# No VITE_ prefix, deliberately: anything prefixed VITE_ is inlined into the
# browser bundle by Vite. A read token there is a considered trade-off; a write
# token there would let anyone create or edit records in the base. Set this in
# Netlify → Site settings → Environment variables, never in client code.
#
# The function also accepts AIRTABLE_WRITE_TOKEN as a fallback name. Without
# either, every enquiry fails with a 503 and nothing reaches Airtable.
NAUGHTY_WRITE=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Admin → Data streams → your web stream, top right.
#
# Leave this blank and analytics is off end to end: no script, no cookies, and
# no consent banner (there would be nothing to consent to). Anything that is not
# a well-formed G- ID is treated as blank.
#
# This is a public identifier — it ships in the bundle by design, exactly like
# the <script> tag it replaces. It is not a secret.
VITE_GA_MEASUREMENT_ID=
